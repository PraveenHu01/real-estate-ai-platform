# Secrets. Vercel injects env vars at runtime; a bundled .env would ship
# real credentials in the deployment and shadow nothing useful — dotenv does
# not override already-set vars, so it can only ever be dead weight or a leak.
.env
.env.*
!.env.example

# Python ML service. scikit-learn/pandas/numpy are not part of the Node
# bundle; the JS fallbacks in backend/utils/cityProfiles.js cover its role.
ml-service/

# Other platforms' deploy configs — stale, and render.yaml's `services:` key
# confuses framework detection.
render.yaml
netlify.toml

# Build output and deps are regenerated by the build, never uploaded.
node_modules/
frontend/dist/
.git/
