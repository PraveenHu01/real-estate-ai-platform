# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# On Vercel these are set under Project Settings -> Environment Variables,
# NOT in a file — the serverless filesystem is read-only.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database (REQUIRED) ---------------------------------------------------
# Postgres holds users, sessions and the audit log. Any provider works:
# Vercel Postgres, Neon, Supabase, or a local install.
# Managed providers require TLS; keep sslmode=require for those.
# After setting this, create the tables once:  npm run db:migrate
DATABASE_URL=postgresql://user:password@host:5432/realestate?sslmode=require

# Local Postgres without TLS:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate

# --- Auth secrets ----------------------------------------------------------
# Generated automatically in development. In production set them explicitly —
# 64+ random hex chars each, and DIFFERENT from one another.
# Generate with: npm run keys
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Origins ---------------------------------------------------------------
# Comma-separated list of frontends allowed to send credentialed requests.
# Same-origin Vercel deploys can leave this as-is.
CLIENT_ORIGIN=http://localhost:3000

# Used to build links in verification and password-reset emails.
APP_URL=http://localhost:3000

# Set to `none` ONLY when the SPA and API are on different registrable domains
# (e.g. Vercel frontend calling a Render backend). Forces Secure, so HTTPS only.
# Same-origin deploys should leave this unset.
# COOKIE_SAMESITE=lax

# Anchored regex allowing deploy-preview origins. Must pin your project slug —
# never widen to all of vercel.app, that would hand sessions to any deployer.
# PREVIEW_ORIGIN_REGEX=^https://real-estate-ai-platform-[a-z0-9-]+\.vercel\.app$

# --- AI providers ----------------------------------------------------------
# Groq is the primary path — fast inference plus tool calling, so the model can
# query live property data instead of being handed a prompt dump.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini is the fallback when Groq is unset or errors.
GEMINI_API_KEY=

# --- Optional services -----------------------------------------------------
# MongoDB backs property listings and chat history. Without it, properties come
# from seed data and chat messages do not persist across serverless containers.
MONGO_URI=

# Python ML service. Cannot run on Vercel (scikit-learn exceeds the bundle
# limit) — deploy it to Render/Railway and put the URL here, or leave it blank
# to use the JS formula fallbacks in utils/cityProfiles.js.
ML_SERVICE_URL=
