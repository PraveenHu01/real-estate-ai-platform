# Copy to .env and fill in your own values.

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB for properties/chat; auth uses SQLite)
MONGO_URI=mongodb://127.0.0.1:27017/real_estate_ai

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Gemini AI (get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Auth secrets (generated automatically by utils/genKeys.js if missing)
# JWT_ACCESS_SECRET=<auto-generated-on-first-run>
# JWT_REFRESH_SECRET=<auto-generated-on-first-run>
# ENCRYPTION_KEY=<auto-generated-32-bytes-hex>
# EMAIL_HMAC_KEY=<auto-generated-32-bytes-hex>
#
# IN PRODUCTION these must be set explicitly as host environment variables.
# genKeys refuses to generate them when NODE_ENV=production, because container
# filesystems are wiped on every deploy: regenerating would invalidate all
# sessions, and a rotated ENCRYPTION_KEY / EMAIL_HMAC_KEY permanently orphans
# already-stored rows. Generate a set once with:
#   node utils/genKeys.js --print

# Auth database location. Defaults to backend/db/realestate_auth.db.
# In production point this at a mounted persistent volume.
# SQLITE_PATH=/var/data/realestate_auth.db

# Frontend origin for CORS. Comma-separated to allow more than one.
CLIENT_ORIGIN=http://localhost:3000

# Optional: allow Netlify/Vercel deploy previews, whose hostnames are generated
# per pull request and cannot be listed above. Must be an ANCHORED regex pinned
# to your project slug. Never widen it to match a whole platform domain —
# anyone can deploy there, and with credentialed CORS that leaks sessions.
# PREVIEW_ORIGIN_REGEX=^https://real-estate-ai-platform-[a-z0-9-]+\.vercel\.app$

# Cookie SameSite policy. Keep 'lax' when the frontend proxies /api through its
# own domain (see netlify.toml / frontend/vercel.json). Use 'none' only when the
# browser calls this backend directly from a different site — that also forces
# Secure, and Safari/Brave restrict such cookies.
COOKIE_SAMESITE=lax

# App URL for email links (printed to console in dev mode)
APP_URL=http://localhost:3000
