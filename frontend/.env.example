# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed vars,
# and it inlines them into the bundle at build time — never put a secret here.

# Leave unset in normal deployments. The Vite dev proxy (dev) and the
# Netlify/Vercel rewrite (production) both serve the API at same-origin /api,
# which keeps auth cookies SameSite=Lax.
# Only set this to a full URL if you deliberately call the backend host
# directly; the backend then also needs COOKIE_SAMESITE=none.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Python ML service. Must be https in production — an http:// URL is blocked as
# mixed content once the site is served over https.
VITE_ML_BASE_URL=http://localhost:8000
